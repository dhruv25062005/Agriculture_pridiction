# ============================================
# AGRICULTURE PREDICTION PLATFORM
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Session security secret (generate a strong random string)
SESSION_SECRET=your_secure_random_session_secret_key_here_min_32_chars

# ============================================
# GOOGLE GEMINI AI API
# ============================================
# Get key from: https://ai.google.dev/
GEMINI_API_KEY=your_google_gemini_api_key_here

# ============================================
# FIREBASE AUTHENTICATION & DATABASE
# ============================================
# Get credentials from Firebase Console: https://console.firebase.google.com

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================
# WEATHER API (Optional - Open-Meteo is free fallback)
# ============================================
# Get key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_optional

# ============================================
# DATABASE CONFIGURATION (Optional for persistence)
# ============================================
# Uncomment if using MongoDB/PostgreSQL for scan history
# DATABASE_URL=mongodb://user:password@localhost:27017/agriculture_db
# DATABASE_TYPE=mongodb

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Maximum file upload size in bytes (default: 30MB)
MAX_FILE_SIZE=31457280

# Rate limiting: requests per minute per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
# For production deployment (e.g., Render, Heroku)
# DEPLOYMENT_ENV=production
# SENTRY_DSN=your_sentry_error_tracking_url

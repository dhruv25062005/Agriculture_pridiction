# ============================================
# AGRICULTURE PREDICTION PLATFORM
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Session security secret (generate a strong random string, 32+ chars)
SESSION_SECRET=your_secure_random_session_secret_key_here_min_32_chars
# Use SESSION_SAMESITE=none only when the app must run cross-site in an iframe.
SESSION_SAMESITE=lax

# ============================================
# GOOGLE GEMINI AI API
# ============================================
GEMINI_API_KEY=your_google_gemini_api_key_here

# ============================================
# FIREBASE WEB CONFIG
# ============================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================
# FIREBASE ADMIN AUTH (SERVER ONLY)
# ============================================
# Recommended on Render: paste the complete Firebase service-account JSON
# as one environment variable. NEVER commit this value to Git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com","client_id":"..."}
# Alternatively use these two server-only variables instead:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# ============================================
# WEATHER API (Optional - Open-Meteo is free fallback)
# ============================================
WEATHER_API_KEY=your_openweathermap_api_key_optional

# ============================================
# DATABASE CONFIGURATION (Optional for persistence)
# ============================================
# DATABASE_URL=mongodb://user:password@localhost:27017/agriculture_db
# DATABASE_TYPE=mongodb

# ============================================
# SECURITY CONFIGURATION
# ============================================
MAX_FILE_SIZE=31457280
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
# On Render, add the production URL to CORS_ORIGINS if other origins need access.
# DEPLOYMENT_ENV=production
# SENTRY_DSN=your_sentry_error_tracking_url

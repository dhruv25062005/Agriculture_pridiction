# ============================================
# AGRICULTURE PREDICTION PLATFORM
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or service-account credentials.

# SERVER CONFIGURATION
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Production must list every browser origin that should access the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
SESSION_SAMESITE=lax

# GOOGLE GEMINI AI API
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional stable model override, e.g. gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# FIREBASE WEB CONFIG
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# FIREBASE ADMIN AUTH (SERVER ONLY)
# Recommended on Render: paste the complete Firebase service-account JSON
# as one environment variable. NEVER commit this value to Git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com","client_id":"..."}
# Or use all three server-only variables:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n# FIREBASE_PROJECT_ID=your_project_id

# FIRESTORE
FIREBASE_FIRESTORE_DATABASE_ID=(default)

# WEATHER
# Open-Meteo is used directly; no API key is required by the current implementation.

# SECURITY
MAX_FILE_SIZE=8388608
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_REQUESTS=60
ALLOW_DEV_CORS=true

# DEPLOYMENT
# Render automatically provides RENDER=true and RENDER_EXTERNAL_URL.
# Add any additional trusted frontend origins to CORS_ORIGINS.
